# --- Accès aux services ---
QBT_URL=http://192.168.1.10:8080
QBT_APIKEY=
XS_URL=http://192.168.1.10:2468
XS_APIKEY=
# Version majeure de cross-seed : vide = détection automatique (recommandé), 6 ou 7 pour la forcer.
# Avec cross-seed v7, utiliser docker-compose.v7.yml.
XS_VERSION=
# Prowlarr et Jackett (facultatifs) : se règlent plutôt dans l'interface (Réglages › Sources d'indexers).
# Valeurs ci-dessous prioritaires sur l'interface ; laisser vide sinon.
PROWLARR_URL=
PROWLARR_APIKEY=
JACKETT_URL=
JACKETT_APIKEY=

# --- Chemins sur l'hôte ---
# Dossier de config de cross-seed (celui monté sur /config dans son conteneur)
XS_CONFIG_PATH=/chemin/vers/cross-seed/config
# Nom du conteneur cross-seed (pour le bouton « Redémarrer »)
XS_CONTAINER=cross-seed

# --- Interface ---
PORT=2469
TZ=Europe/Paris
# Mot de passe de l'interface ; vide = pas d'authentification (réseau local de confiance uniquement)
UI_USER=admin
UI_PASSWORD=
