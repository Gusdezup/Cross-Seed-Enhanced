# --- Accès aux services ---
# Clients torrent : par défaut, ceux de cross-seed (torrentClients de config.js en v6).
# QBT_URL / QBT_APIKEY : un seul qBittorrent (ancien format, toujours valable). Avec les clients de
# cross-seed, le qBittorrent de même port reprend cette adresse et cette clé API.
QBT_URL=http://192.168.1.10:8080
QBT_APIKEY=
# Ou une liste explicite, prioritaire, avec la syntaxe torrentClients de cross-seed :
# TORRENT_CLIENT_1=qbittorrent:http://192.168.1.10:8081
# TORRENT_CLIENT_1_APIKEY=             # qBittorrent >= 5.2 ; sinon http://user:motdepasse@hôte:port
# TORRENT_CLIENT_1_NAME=principal
# TORRENT_CLIENT_2=qbittorrent:http://admin:motdepasse@192.168.1.10:8082
# TORRENT_CLIENT_3=rtorrent:http://user:pass@192.168.1.10/RPC2
# TORRENT_CLIENT_4=transmission:http://user:pass@192.168.1.10:9091/transmission/rpc
# TORRENT_CLIENT_5=deluge:http://:pass@192.168.1.10:8112/json
# Hôte qui remplace localhost dans les adresses lues chez cross-seed (vide : l'hôte de QBT_URL)
TORRENT_CLIENT_HOST=
XS_URL=http://192.168.1.10:2468
XS_APIKEY=
# Version majeure de cross-seed : vide = détection automatique (recommandé), 6 ou 7 pour la forcer.
# Avec cross-seed v7, utiliser docker-compose.v7.yml.
XS_VERSION=
# Prowlarr et Jackett (facultatifs) : se règlent plutôt dans l'interface (Réglages › Sources d'indexers).
# Valeurs ci-dessous prioritaires sur l'interface ; laisser vide sinon.
PROWLARR_URL=
PROWLARR_APIKEY=
JACKETT_URL=
JACKETT_APIKEY=

# --- Chemins sur l'hôte ---
# Dossier de config de cross-seed (celui monté sur /config dans son conteneur)
XS_CONFIG_PATH=/chemin/vers/cross-seed/config
# Nom du conteneur cross-seed (pour le bouton « Redémarrer »)
XS_CONTAINER=cross-seed

# --- Interface ---
PORT=2469
TZ=Europe/Paris
# Mot de passe de l'interface ; vide = pas d'authentification (réseau local de confiance uniquement)
UI_USER=admin
UI_PASSWORD=
