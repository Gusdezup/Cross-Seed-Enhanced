# --- Accès aux services ---
QBT_URL=http://192.168.1.10:8080
QBT_APIKEY=
XS_URL=http://192.168.1.10:2468
XS_APIKEY=

# --- Chemins sur l'hôte ---
# Dossier de config de cross-seed (celui monté sur /config dans son conteneur)
XS_CONFIG_PATH=/chemin/vers/cross-seed/config
# Nom du conteneur cross-seed (pour le bouton « Redémarrer »)
XS_CONTAINER=cross-seed

# --- Interface ---
PORT=2469
TZ=Europe/Paris
# Mot de passe de l'interface ; vide = pas d'authentification (réseau local de confiance uniquement)
UI_USER=admin
UI_PASSWORD=
